{
  "name": "wordquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "单词勇者 WordQuest — 把背单词 + 练听力变成像素 RPG 冒险的离线四六级学习应用",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/build-taster.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "ingest:ecdict": "node scripts/ingest-ecdict.mjs",
    "fetch:ecdict": "node scripts/fetch-ecdict.mjs",
    "ingest:roots": "node scripts/ingest-roots.mjs",
    "demo": "python scripts/build-demo.py",
    "serve": "node scripts/serve.mjs",
    "test": "tsx --tsconfig tsconfig.app.json --test test/*.test.ts",
    "start": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.3.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.2.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
